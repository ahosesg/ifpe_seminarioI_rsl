\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{latex/abnt-revisao}[2026/10/17 Apresentacao academica da revisao]
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english,brazilian]{babel}
\RequirePackage{mathptmx,textcomp,microtype,geometry}
\geometry{a4paper,left=3cm,right=2cm,top=3cm,bottom=2cm,headheight=14pt,headsep=0.65cm}
\RequirePackage{setspace,indentfirst}
\onehalfspacing
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}
\RequirePackage{amsmath,array,booktabs,longtable,tabularx,ragged2e}
\RequirePackage{float,caption}
\newfloat{quadro}{htbp}{loq}
\floatname{quadro}{Quadro}
\DeclareCaptionLabelSeparator{traco}{\space--\space}
\captionsetup{font=small,labelfont=normalfont,labelsep=traco,justification=raggedright,singlelinecheck=false,position=top}
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.15}
\newcolumntype{P}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcommand{\Fonte}[1]{\par\nobreak\noindent{\setstretch{1}\fontsize{10}{12}\selectfont Fonte: #1\par}}
\newcommand{\NotaQuadro}[1]{\noindent{\setstretch{1}\fontsize{10}{12}\selectfont Nota: #1\par}}
\RequirePackage{titlesec,tocloft}
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{2}
\titleformat{\chapter}[hang]{\normalfont\bfseries\normalsize}{\thechapter}{1em}{}
\titlespacing*{\chapter}{0pt}{0pt}{\baselineskip}
\titleformat{\section}[hang]{\normalfont\bfseries\normalsize}{\thesection}{1em}{}
\titlespacing*{\section}{0pt}{\baselineskip}{\baselineskip}
\titleformat{\subsection}[hang]{\normalfont\itshape\normalsize}{\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{\baselineskip}{\baselineskip}
\titleformat{\subsubsection}[hang]{\normalfont\normalsize}{\thesubsubsection}{1em}{}
\titlespacing*{\subsubsection}{0pt}{\baselineskip}{\baselineskip}
\titleformat{\paragraph}[hang]{\normalfont\itshape\normalsize}{\theparagraph}{1em}{}
\titlespacing*{\paragraph}{0pt}{\baselineskip}{\baselineskip}
\addto\captionsbrazilian{\renewcommand{\contentsname}{SUMÁRIO}}
\renewcommand{\cfttoctitlefont}{\hfill\normalfont\bfseries\normalsize}
\renewcommand{\cftaftertoctitle}{\hfill\mbox{}}
\setlength{\cftbeforetoctitleskip}{0pt}
\setlength{\cftaftertoctitleskip}{\baselineskip}
\setlength{\cftchapindent}{0pt}
\setlength{\cftsecindent}{0pt}
\setlength{\cftsubsecindent}{0pt}
\setlength{\cftchapnumwidth}{2.6em}
\setlength{\cftsecnumwidth}{2.6em}
\setlength{\cftsubsecnumwidth}{2.6em}
\renewcommand{\cftchapfont}{\normalfont\bfseries}
\renewcommand{\cftchappagefont}{\normalfont\bfseries}
\renewcommand{\cftsecfont}{\normalfont\bfseries}
\renewcommand{\cftsecpagefont}{\normalfont\bfseries}
\renewcommand{\cftsubsecfont}{\normalfont\itshape}
\renewcommand{\cftsubsecpagefont}{\normalfont\itshape}
\RequirePackage{fancyhdr}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}}
\pagestyle{empty}
\newcommand{\AtivarPaginacao}{%
  \fancypagestyle{plain}{\fancyhf{}\fancyhead[R]{\normalfont\small\thepage}\renewcommand{\headrulewidth}{0pt}}%
  \fancypagestyle{abnt}{\fancyhf{}\fancyhead[R]{\normalfont\small\thepage}\renewcommand{\headrulewidth}{0pt}}%
  \pagestyle{abnt}}
\RequirePackage{csquotes,xurl,fvextra}
\RequirePackage[backend=biber,style=abnt,sorting=nty,giveninits=true,maxcitenames=3,mincitenames=1,maxbibnames=99,uniquename=false,uniquelist=false,doi=true,url=true,isbn=false]{biblatex}
% NBR 10520:2023: chamadas com caixa normal; referências preservam caixa alta.
\ifcsname NormalOrSCCite\endcsname\let\UpperOrSCCite\NormalOrSCCite\fi
\DefineBibliographyStrings{brazilian}{andothers={\textit{et\addabbrvspace al\adddot}}}
\renewcommand*{\bibfont}{\normalfont\normalsize}
\setlength{\bibitemsep}{\baselineskip}
\setlength{\bibparsep}{0pt}
\AtBeginBibliography{\singlespacing\RaggedRight\setlength{\bibitemsep}{\baselineskip}}
\defbibheading{referencias}[REFERÊNCIAS]{\TituloPostextual{#1}}
\RequirePackage[hidelinks,unicode,pdfencoding=auto]{hyperref}
\hypersetup{bookmarksnumbered=true,pdfdisplaydoctitle=true}
\newcommand{\TituloPretextual}[1]{\clearpage\phantomsection\begin{center}\bfseries #1\end{center}\vspace{\baselineskip}}
\newcommand{\SumarioRevisao}{\clearpage\tableofcontents\clearpage}
\newcommand{\TituloPostextual}[1]{\clearpage\phantomsection\addcontentsline{toc}{chapter}{\protect\numberline{}#1}\begin{center}\bfseries #1\end{center}\vspace{\baselineskip}}
\newcommand{\CapaRevisao}[1]{%
  \thispagestyle{empty}\begin{center}
  {\bfseries\InstituicaoRevisao\par\ProgramaRevisao\par}
  \vspace{2cm}{\AutorRevisao\par}\vfill
  {\bfseries #1\par}\vfill
  {\LocalRevisao\par\AnoRevisao\par}\end{center}\clearpage\setcounter{page}{1}}
\newcommand{\FolhaRostoRevisao}[2]{%
  \thispagestyle{empty}\begin{center}\AutorRevisao\par\vfill{\bfseries #1\par}\end{center}
  \vspace{1.5cm}\hfill\begin{minipage}{0.5\textwidth}\singlespacing #2\par\vspace{1em}\DataRevisao.\end{minipage}\par
  \vfill\begin{center}\LocalRevisao\par\AnoRevisao\end{center}\clearpage}
\newcommand{\MPdez}{MP\textsubscript{10}}
\newcommand{\MPdoiscinco}{MP\textsubscript{2,5}}
\newcommand{\ugm}{\ensuremath{\mu\mathrm{g}\,\mathrm{m}^{-3}}}
